# ===========================================================================
# LeadAI environment variables
# ===========================================================================
# APPEND these to the .env file the outbound app already uses. Nothing here
# renames or overrides an existing variable — LeadAI reads the SAME .env, so
# MYSQL_*, SERVER_URL, TWILIO_*, SARVAM_API_KEY and LOCAL_IDENTITY_SERVER are
# picked up from your current configuration untouched.
#
# Every value below has a working default. The platform boots with none of them
# set (in degraded/offline mode) and tells you which mode it is in at
# GET /api/leadai/health.
# ===========================================================================


# ---------------------------------------------------------------------------
# 1. RBAC BOOTSTRAP  (set this first, then remove it)
# ---------------------------------------------------------------------------
# A fresh install has an empty leadai_user_roles table, which would lock
# everyone out. Emails listed here are auto-granted Admin the first
# time they call the API. Once your real admins are granted, delete this line.
LEADAI_BOOTSTRAP_ADMINS=you@yourcompany.com


# ---------------------------------------------------------------------------
# 2. OPENAI  — embeddings + reply generation
# ---------------------------------------------------------------------------
# Leave OPENAI_API_KEY unset to run the built-in offline engine:
#   embeddings -> deterministic hashed-ngram vectors
#   answering  -> extractive (quotes the company's own documents)
# Retrieval, qualification, handoff and the whole lead pipeline still work.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Chat/answer model. gpt-4o-mini is the cost/quality sweet spot for grounded
# Q&A over a company knowledge base.
OPENAI_MODEL=gpt-4o-mini

# Embedding model. 1536 dims, cheap enough to embed a whole handbook, and
# multilingual enough for Hinglish/Indic phone transcripts from Sarvam STT.
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIM=1536
OPENAI_TIMEOUT=45


# ---------------------------------------------------------------------------
# 3. RAG TUNING
# ---------------------------------------------------------------------------
# How many chunks to retrieve per question.
LEADAI_RETRIEVAL_TOP_K=5

# Below this answer confidence, the AI hands off to a human instead of guessing.
# This is the single most important safety dial in the product.
#   0.55-0.65 -> cautious (banking, insurance, healthcare)
#   0.40      -> balanced (default)
#   0.25-0.35 -> let the bot keep trying (retail, real estate)
# Can be overridden PER COMPANY via PUT /api/leadai/companies/{id}/settings.
LEADAI_HANDOFF_THRESHOLD=0.40

# Chunking. ~900 chars ≈ 200 tokens: large enough to hold a complete answer,
# small enough that a retrieved chunk is mostly signal.
LEADAI_CHUNK_MAX_CHARS=900
LEADAI_CHUNK_OVERLAP=150

# Hybrid score weighting: dense (vector) vs sparse (IDF lexical coverage).
# Raise toward 1.0 to trust embeddings more; lower it to favour exact keyword
# matching (better for rate cards, policy numbers, product codes).
LEADAI_HYBRID_VECTOR_WEIGHT=0.55

# Max knowledge-base upload size in bytes (default 15 MB).
LEADAI_MAX_UPLOAD_BYTES=15728640


# ---------------------------------------------------------------------------
# 4. VECTOR STORE  (optional)
# ---------------------------------------------------------------------------
# Unset -> embeddings stored in leadai_kb_chunks, scored in-process with numpy.
# Set    -> dense half offloaded to Qdrant with a client_id payload filter.
# QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=leadai_company_knowledge


# ---------------------------------------------------------------------------
# 5. CACHE / RATE LIMITING  (optional)
# ---------------------------------------------------------------------------
# Required if you run more than one uvicorn worker — a per-process rate limit
# is no rate limit at all once you scale out.
# REDIS_URL=redis://localhost:6379/0


# ---------------------------------------------------------------------------
# 6. PII ENCRYPTION
# ---------------------------------------------------------------------------
# Fernet key used to encrypt customer phone/email/social handles at rest.
# Generate with:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
#
# IMPORTANT: if left blank, a key is derived deterministically from
# JWT_SECRET_KEY. That works, but rotating JWT_SECRET_KEY would then make every
# stored contact undecryptable. Set this explicitly in production.
LEADAI_PII_KEY=


# ---------------------------------------------------------------------------
# 7. CUSTOMER CHAT WIDGET SESSIONS
# ---------------------------------------------------------------------------
# End customers have no identity-server account, so they get a short-lived token
# bound to one conversation. Defaults to JWT_SECRET_KEY when unset.
LEADAI_CHAT_JWT_SECRET=
LEADAI_CHAT_SESSION_MINUTES=1440
LEADAI_CHAT_RATE_LIMIT=30


# ---------------------------------------------------------------------------
# 8. TELEPHONY — EXOTEL
# ---------------------------------------------------------------------------
# Which carrier the LeadAI voice endpoints use:
#   auto   -> Exotel when credentials exist, else the existing Twilio leg
#   exotel -> force Exotel
#   twilio -> force the already-working Twilio pipeline
LEADAI_VOICE_PROVIDER=auto

EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
# Your DLT-registered ExoPhone — the number the customer sees.
EXOTEL_CALLER_ID=
EXOTEL_SUBDOMAIN=api.exotel.com

# App Bazaar flow id containing the Voicebot/Stream applet that connects the
# caller's audio to this app's /media-stream WebSocket. Without it, calls are
# bridged to the caller id (a plain agent<->customer call, no bot).
EXOTEL_FLOW_APP_ID=


# ---------------------------------------------------------------------------
# 9. SARVAM (STT / TTS)  — already used by the outbound app
# ---------------------------------------------------------------------------
# Listed for completeness: sarvam_stt.py / sarvam_tts.py read this today.
# SARVAM_API_KEY=
LEADAI_DEFAULT_LANGUAGE=en-IN


# ---------------------------------------------------------------------------
# 10. MISC
# ---------------------------------------------------------------------------
# Change only if you need to mount LeadAI somewhere other than /api/leadai.
LEADAI_API_PREFIX=/api/leadai
LEADAI_STRICT_TENANT_ISOLATION=true
