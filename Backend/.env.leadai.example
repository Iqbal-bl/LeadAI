# =========================================================================== #
# LeadAI feature expansion — environment reference
# =========================================================================== #
# Copy the lines you need into your existing .env. EVERY variable here has a
# working default, so an existing deployment keeps running unchanged if you add
# none of them. The defaults are shown after each `=`.
#
# The guiding rule: nothing in this file is required to boot. Features switch
# themselves off when their credentials are absent rather than raising at
# startup, so you can roll out one channel at a time.
# =========================================================================== #


# --------------------------------------------------------------------------- #
# 1. Social channels (WhatsApp Cloud API, Messenger, Instagram)
# --------------------------------------------------------------------------- #
# Master switch. With this off, the webhook endpoints still exist but reject
# traffic, and only the web chat widget produces leads. Leave it off until the
# Meta app review is through.
LEADAI_SOCIAL_CHANNELS_ENABLED=true

# The web chat widget. Keep this TRUE — it is the fallback while social
# integration is being approved, and turning it off orphans the widget embed.
LEADAI_WEB_CHAT_ENABLED=true

# App-level secret from the Meta app dashboard (Settings -> Basic -> App
# Secret). Used to verify the X-Hub-Signature-256 header on every webhook POST.
# Per-channel-account secrets, stored encrypted in the database, take priority
# over this one; this is the fallback for single-tenant installs.
META_APP_SECRET=

# The token Meta echoes back during the webhook handshake. You type the same
# string into the Meta dashboard "Verify Token" box. Any random string works —
# it proves the endpoint is yours, nothing more.
META_VERIFY_TOKEN=

# Set to false ONLY for local testing with curl. In production a forged webhook
# could inject fake leads and trigger outbound AI replies at your expense.
META_VERIFY_SIGNATURES=true

# Graph API version and base. Bump the version deliberately — Meta deprecates
# versions on a ~2 year cycle and the payload shapes change between them.
META_GRAPH_VERSION=v21.0
META_GRAPH_BASE=https://graph.facebook.com

# Fallback page/system-user access token for single-tenant installs. Multi-tenant
# deployments store one encrypted token per channel account instead.
META_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Meta's customer-service window, in hours. Inside it you may send free-form
# messages; outside it only approved templates go through. 24 is Meta's number —
# do not raise it hoping for leniency, the API simply rejects the send.
META_SESSION_WINDOW_HOURS=24


# --------------------------------------------------------------------------- #
# 2. Lead score threshold
# --------------------------------------------------------------------------- #
# Platform-wide default. Each company can override it from the settings screen
# (PUT /api/leadai/threshold), and the per-company value always wins.
LEADAI_LEAD_THRESHOLD=50

# Score at or above which a lead is automatically promoted to a CRM customer
# record. Leave blank to require a human to press "Convert" — recommended until
# you trust the scoring on your own data.
LEADAI_AUTO_CONVERT_THRESHOLD=


# --------------------------------------------------------------------------- #
# 3. Campaigns
# --------------------------------------------------------------------------- #
# Hard ceiling on recipients per campaign. A guard against someone uploading a
# 4-million-row list and discovering the cost afterwards.
LEADAI_CAMPAIGN_MAX_RECIPIENTS=100000

# How many sends are in flight at once, and the per-minute ceiling. Start low.
# WhatsApp throttles unproven senders and quality-rates you down for bursts.
LEADAI_CAMPAIGN_CONCURRENCY=5
LEADAI_CAMPAIGN_RATE_PER_MIN=60

# Recipients processed per job batch. Each batch re-queues itself, so this is
# the granularity at which a pause takes effect.
LEADAI_CAMPAIGN_BATCH_SIZE=200

# How many times a single failed recipient is retried before it is marked
# permanently failed. Backoff is 30s, 60s, then 120s.
LEADAI_CAMPAIGN_MAX_RETRIES=3

# Quiet hours, local to the company timezone below. India's TRAI rules forbid
# promotional contact outside 09:00-21:00; transactional messages bypass this.
LEADAI_QUIET_HOURS_START=9
LEADAI_QUIET_HOURS_END=21
LEADAI_TIMEZONE=Asia/Kolkata

# Dry run: build audiences, render every message, record the outcome — but never
# actually hit the send API. Use this for the first campaign on a new install.
LEADAI_CAMPAIGN_DRY_RUN=false


# --------------------------------------------------------------------------- #
# 4. Background worker
# --------------------------------------------------------------------------- #
# TRUE on exactly one process (the leadai-worker container). FALSE on the API
# replicas — otherwise every replica competes for jobs and steals threads from
# the latency-sensitive voice pipeline.
LEADAI_WORKER_ENABLED=true
LEADAI_WORKER_POLL_SECONDS=3
LEADAI_WORKER_CONCURRENCY=4
# Optional friendly name in logs and in GET /files/jobs/stats. Defaults to the
# hostname, which is usually what you want under Docker.
LEADAI_WORKER_ID=


# --------------------------------------------------------------------------- #
# 5. Object storage (MinIO)
# --------------------------------------------------------------------------- #
# The first four already exist for call recordings. The three bucket names below
# are new. Separate buckets, not folders, so retention policies differ per kind.
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1
MINIO_BUCKET=call-recordings

MINIO_BUCKET_DOCUMENTS=leadai-documents
MINIO_BUCKET_CAMPAIGNS=leadai-campaigns
MINIO_BUCKET_EXPORTS=leadai-exports

# Lifetime of a presigned download URL, in seconds. Buckets stay private; every
# download is a signed, expiring link. 15 minutes is long enough to click.
MINIO_PRESIGN_SECONDS=900

# Set true when MinIO/S3 is behind HTTPS.
MINIO_SECURE=false

# Largest single upload accepted, in bytes (default 25 MB).
LEADAI_MAX_UPLOAD_BYTES=26214400

# Where files land when MinIO is not configured at all. The store degrades to
# local disk rather than failing, so development works with zero setup — but
# this directory is NOT shared between containers, so configure MinIO in prod.
LEADAI_LOCAL_STORAGE_DIR=./data_files/leadai


# --------------------------------------------------------------------------- #
# 6. SMS and email fallback channels
# --------------------------------------------------------------------------- #
# Reuses the Twilio credentials already configured for voice.
TWILIO_SMS_FROM=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true


# --------------------------------------------------------------------------- #
# 7. Schema migration
# --------------------------------------------------------------------------- #
# On boot the app adds any missing columns to leadai_* tables. It only ever runs
# ADD COLUMN — never DROP, MODIFY or RENAME — so it cannot destroy data. Set to
# false if you manage schema with Alembic or apply DDL by hand.
LEADAI_AUTO_MIGRATE=true
