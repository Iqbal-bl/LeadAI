# --------------------------------------------------
# agentic_browser_v2 / .env.example
# --------------------------------------------------
# --- LLM (required) ---
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- CRAG (required if you use answer_company_question) ---
GOOGLE_API_KEY=
TAVILY_API_KEY=
CRAG_ALLOW_WEB_SEARCH=false

# --- Meta Graph API (required for the Page) — see docs/GRAPH_API_SETUP.md ---
FB_APP_ID=
FB_APP_SECRET=
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# --- Meta Webhook (required to receive Instagram message events) ---
# Use the same long random value in the Meta dashboard's Verify Token field.
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_PORT=8000

# --- MinIO media hosting (required by POST /direct/posts with media) ---
# MINIO_ENDPOINT is the S3 API endpoint, not the MinIO Console URL.
# MINIO_PUBLIC_BASE_URL must be a public HTTPS origin Meta can fetch from.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=lead-ai
MINIO_PREFIX=posts
MINIO_PUBLIC_BASE_URL=
MINIO_REGION=us-east-1
# Keep true in production. Set false only for a company-internal endpoint
# using a self-signed certificate, or install the company's CA certificate.
MINIO_TLS_VERIFY=true

# --- Optional: vision fallback (OmniParser via Replicate) ---
REPLICATE_API_TOKEN=
