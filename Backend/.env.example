# ===========================================================================
#  AIOutbound + LeadAI + Social Publishing — environment reference
# ===========================================================================
#  Every variable below is read somewhere in this codebase. Copy to `.env`
#  and fill in what you need.
#
#  Sections marked [REQUIRED] must be set or the app will not start.
#  Everything else has a working default, shown as the value.
#
#  Precedence note that matters: for Meta credentials, the per-company rows in
#  `leadai_channel_accounts` ALWAYS win. The META_* / FB_* variables here are
#  platform-level fallbacks for single-tenant or local use only — see §9.
# ===========================================================================


# ===========================================================================
#  1. CORE  [REQUIRED]
# ===========================================================================
# MySQL — the single engine shared by the outbound app, LeadAI and social.
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=aioutbound

# Public base URL of THIS service. Used to build webhook/callback URLs handed
# to Twilio, Exotel and Meta, so it must be reachable from the internet.
SERVER_URL=https://api.yourcompany.com

# Identity server (token validation). Discovery + JWKS are fetched from here.
LOCAL_IDENTITY_SERVER=https://identity.yourcompany.com
# Expected `iss` claim, if it differs from the discovery URL above.
TOKEN_ISSUER=

PORT=5050
ENVIRONMENT=production


# ===========================================================================
#  2. IDENTITY / JWT
# ===========================================================================
JWT_SECRET_KEY=change-this-to-a-long-random-string
SESSION_SECRET=change-this-too
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60
JWT_REFRESH_EXPIRES_MINUTES=10080
JWT_LEEWAY=10
JWT_COOKIE_NAME=access_token
JWT_REFRESH_COOKIE_NAME=refresh_token
JWT_COOKIE_SECURE=true

# Identity-provider fetch tuning.
IDP_CONNECT_TIMEOUT=5
IDP_READ_TIMEOUT=10
IDP_FETCH_RETRIES=3
IDP_JWKS_TTL=3600
IDP_LEEWAY=10


# ===========================================================================
#  3. LEADAI PLATFORM
# ===========================================================================
LEADAI_API_PREFIX=/api/leadai

# FIRST RUN ONLY. A fresh install has an empty roles table, which locks
# everyone out. Emails here are auto-granted Admin on first API call.
# Remove this line once your real admins exist.
LEADAI_BOOTSTRAP_ADMINS=you@yourcompany.com

# Fernet key encrypting customer PII *and* the Meta access tokens in
# leadai_channel_accounts. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ROTATING THIS WITHOUT RE-ENCRYPTING makes every stored token undecryptable,
# and connected channels start reporting "reconnect this account".
LEADAI_PII_KEY=

# Additive ADD COLUMN migration on startup. Leave on unless you run Alembic.
LEADAI_AUTO_MIGRATE=true
LEADAI_STRICT_TENANT_ISOLATION=true
LEADAI_TIMEZONE=Asia/Kolkata
LEADAI_DEFAULT_LANGUAGE=en-IN
LEADAI_MAX_UPLOAD_BYTES=15728640
LEADAI_LOCAL_STORAGE_DIR=./storage_local

# Chat widget sessions.
LEADAI_CHAT_JWT_ALG=HS256
LEADAI_CHAT_SESSION_MINUTES=120
LEADAI_CHAT_JWT_LEEWAY=10
LEADAI_CHAT_RATE_LIMIT=30

# Lead scoring.
LEADAI_LEAD_THRESHOLD=50
LEADAI_AUTO_CONVERT_THRESHOLD=0


# ===========================================================================
#  4. SOCIAL PUBLISHING            <-- the new feature
# ===========================================================================
# Fail closed when no company is bound to the request.
#
# LEAVE THIS TRUE. With it false, a Graph call made outside a request context
# silently falls back to FB_PAGE_ACCESS_TOKEN below — so a wiring bug shows up
# as "posted to the wrong company's Page" instead of a loud error. The fallback
# exists only for the standalone single-tenant scripts in tasks/.
LEADAI_SOCIAL_STRICT_TENANCY=true

# Master switch for social channels (messaging + publishing).
LEADAI_SOCIAL_CHANNELS_ENABLED=true
LEADAI_WEB_CHAT_ENABLED=true

# --- Media hosting for posts -----------------------------------------------
# Meta FETCHES media from the URL you give it — nothing is uploaded to Meta
# directly, and for Instagram inline upload is impossible. So this bucket must
# be reachable from META'S servers, not just from yours.
#
# THE #1 DEPLOYMENT FAILURE. All of these break, and they break on Meta's side
# with an unhelpful message:
#   - a LAN/private address (http://192.168.x.x:9000)
#   - the MinIO *console* URL instead of the object endpoint
#   - plain HTTP
#   - anything behind auth
# Verify by curl-ing MINIO_PUBLIC_BASE_URL from outside your network.
MINIO_PUBLIC_BASE_URL=https://cdn.yourcompany.com
MINIO_BUCKET=social-media
MINIO_PREFIX=posts


# ===========================================================================
#  5. OBJECT STORAGE (MinIO / S3)
# ===========================================================================
# Internal endpoint the server writes through.
MINIO_ENDPOINT=https://minio.internal:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_REGION=us-east-1
MINIO_SECURE=true
MINIO_TLS_VERIFY=true
MINIO_VERIFY_SSL=true
MINIO_CA_BUNDLE=

# Public read endpoint for presigned URLs (LeadAI document store).
MINIO_PUBLIC_ENDPOINT=https://cdn.yourcompany.com
MINIO_PRESIGN_SECONDS=3600

# Separate buckets keep lifecycle rules independent.
MINIO_BUCKET_DOCUMENTS=leadai-documents
MINIO_BUCKET_CAMPAIGNS=leadai-campaigns
MINIO_BUCKET_EXPORTS=leadai-exports

# Only if you use real AWS S3 instead of MinIO.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=
AWS_DEFAULT_REGION=


# ===========================================================================
#  6. LLM / AI
# ===========================================================================
# Used by LeadAI (captions, chat, lead qualification) and the content agent.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=45.0
# Model used by the multilingual voice agent's chat turn (separate from
# OPENAI_MODEL above, which LeadAI and the content agent use).
OPENAI_CHAT_MODEL=sarvam-105b

# The vendored content agent picks its provider here. Default is groq;
# set to "openai" to reuse OPENAI_API_KEY above.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
VISION_MODEL=gpt-4o-mini

# Embeddings.
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIM=1536
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=google
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001

# Retrieval tuning (RAG).
LEADAI_RETRIEVAL_TOP_K=5
LEADAI_HANDOFF_THRESHOLD=0.40
LEADAI_CHUNK_MAX_CHARS=900
LEADAI_CHUNK_OVERLAP=150
LEADAI_HYBRID_VECTOR_WEIGHT=0.55

# Optional ANN index. Unset = embeddings live in leadai_kb_chunks (no extra infra).
QDRANT_URL=
QDRANT_COLLECTION=leadai_company_knowledge

# CRAG web-search fallback when the knowledge base can't answer.
CRAG_ALLOW_WEB_SEARCH=false
TAVILY_API_KEY=

# Image generation for posts submitted without an image_url.
REPLICATE_API_TOKEN=


# ===========================================================================
#  7. VOICE / TELEPHONY
# ===========================================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_CALLER_ID=

EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_FLOW_APP_ID=

# auto | twilio | exotel
LEADAI_VOICE_PROVIDER=auto

# Speech.
SARVAM_API_KEY=
SARVAM_TTS_PING_INTERVAL=20
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
AUDIO_RATE=8000

BATCH_DEFAULT_LANGUAGE=en-IN
BATCH_DEFAULT_GENDER=female


# ===========================================================================
#  8. CAMPAIGNS & WORKER
# ===========================================================================
LEADAI_CAMPAIGN_MAX_RECIPIENTS=100000
LEADAI_CAMPAIGN_CONCURRENCY=5
LEADAI_CAMPAIGN_RATE_PER_MIN=60
LEADAI_CAMPAIGN_MAX_RETRIES=1
LEADAI_CAMPAIGN_BATCH_SIZE=200
LEADAI_CAMPAIGN_DRY_RUN=false

# Quiet hours, local time. India's TRAI rules bar promotional contact
# outside 09:00–21:00.
LEADAI_QUIET_HOURS_START=9
LEADAI_QUIET_HOURS_END=21

# ONLY ONE PROCESS should drain the job queue. When scaling uvicorn
# horizontally, set this false on the extra web pods and run one dedicated
# worker container.
LEADAI_WORKER_ENABLED=true
LEADAI_WORKER_POLL_SECONDS=3.0
LEADAI_WORKER_CONCURRENCY=4
LEADAI_WORKER_ID=

REDIS_URL=


# ===========================================================================
#  9. META PLATFORM FALLBACKS  —  read §4 before setting anything here
# ===========================================================================
# Per-company credentials in `leadai_channel_accounts` ALWAYS take precedence.
# In normal multi-tenant operation you should leave the token/id variables in
# this section EMPTY. Companies connect their own accounts through
# POST /api/leadai/channels, and that is the only path publishing uses.

# App-level webhook settings — these ARE used in production. Meta calls one
# webhook URL for your whole app; the payload's account id routes it to the
# right tenant.
META_APP_SECRET=
META_VERIFY_TOKEN=leadai-verify
META_VERIFY_SIGNATURES=true
META_GRAPH_VERSION=v21.0
META_GRAPH_BASE=https://graph.facebook.com
# Meta only permits free-form replies within 24h of the user's last message.
META_SESSION_WINDOW_HOURS=24

# --- Single-tenant fallbacks. LEAVE BLANK for multi-tenant deployments. -----
# Used only when a company has connected no account of its own, and (for
# FB_*/IG_*) only when LEADAI_SOCIAL_STRICT_TENANCY=false.
META_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
FB_PAGE_ACCESS_TOKEN=
FB_PAGE_ID=
IG_BUSINESS_ACCOUNT_ID=
GRAPH_API_VERSION=v25.0


# ===========================================================================
# 10. SMS / EMAIL FALLBACK
# ===========================================================================
TWILIO_SMS_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true


# ===========================================================================
# 11. LOCAL DEVELOPMENT ONLY
# ===========================================================================
# Public tunnel when developing behind NAT, so Meta/Twilio webhooks can reach
# you. Not for production — use SERVER_URL.
NGROK_URL=
NGURL=

DEFAULT_TENANT_EMAIL=
DEFAULT_USER_EMAIL=
DEFAULT_USER_PASSWORD=

# Optional Cloudinary alternative to MinIO for media hosting.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Standalone Instagram (Instagram API with Instagram Login) --------------
# From a SECOND Meta app configured with "API setup with Instagram Login".
# Meta permits only ONE api setup per app, so these are necessarily different
# values from META_APP_ID / META_APP_SECRET above. Reusing the Facebook ones is
# the most common reason the connect flow fails with an opaque OAuth error.
# See INSTAGRAM_STANDALONE_SETUP.md.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://api.yourcompany.com/channels/instagram/callback
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_GRAPH_VERSION=v23.0
INSTAGRAM_GRAPH_BASE=https://graph.instagram.com
