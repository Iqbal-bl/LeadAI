{
  "manifest_version": 3,
  "name": "LeadAI - LinkedIn 1-Click Connector",
  "version": "1.0.0",
  "description": "Seamlessly link your LinkedIn account to LeadAI in 1 click without passwords, DevTools, or copy-pasting.",
  "permissions": [
    "cookies",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.leadai.*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LeadAI LinkedIn Sync"
  }
}
